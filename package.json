{
  "name": "nomnomgo",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "start:localhost": "expo start --localhost",
    "start:tunnel": "expo start --tunnel",
    "start:web": "expo start --web --localhost",
    "start:web:tunnel": "expo start --web --tunnel --port 8100",
    "android": "expo run:android",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:web": "expo export -p web",
    "export:android": "expo export --platform android --output-dir .expo-export-check/android",
    "export:ios": "expo export --platform ios --output-dir .expo-export-check/ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:route-import": "tsc --module commonjs --target ES2020 --skipLibCheck --esModuleInterop --outDir .route-import-test-build routeImport.ts routeHandoff.ts planningHours.ts alphaAccess.ts src/domain/itinerary.ts src/domain/searchExecution.ts src/domain/eventDiscovery.ts && node --test tests/routeImport.test.js tests/routeHandoff.test.js tests/planningHours.test.js tests/alphaAccess.test.js tests/itinerary.test.js tests/searchExecution.test.js tests/eventDiscovery.test.js",
    "test": "npm run test:route-import",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "latest",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sortables": "^1.10.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  }
}
