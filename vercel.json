{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "devCommand": "npm run start:web",
  "cleanUrls": true,
  "framework": null,
  "functions": {
    "api/local-areas.js": { "maxDuration": 30 }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}
