{
  "expo": {
    "name": "NomNomGo",
    "slug": "nomnomgo",
    "scheme": "nomnomgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/nom-nom-go-icon-v19.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/nom-nom-go-splash-v19.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A0C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/nom-nom-go-icon-v19.png"
    },
    "android": {
      "package": "com.differancelabs.nomnomgo",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/nom-nom-go-adaptive-icon-v19.png",
        "backgroundColor": "#080A0C"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#080A0C",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#080A0C",
      "barStyle": "light-content"
    },
    "ios": {
      "bundleIdentifier": "com.differancelabs.nomnomgo",
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NomNomGo uses your approximate location to make nearby food and activity suggestions."
        }
      ],
      "expo-font",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
